build/
dist/
*.egg-info/
*.egg

# Unit test / coverage reports
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Type checker caches
.mypy_cache/
.ruff_cache/

# Environments
.env
env/
venv/
