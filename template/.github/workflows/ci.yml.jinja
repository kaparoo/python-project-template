name: CI

on:
  push:
    branches: [main]
  pull_request:
  workflow_call:

concurrency:
  group: ci-{% raw %}${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  check:
    name: Lint, type-check, {% if use_pytest %}test{% else %}import{% endif %} ({% raw %}${{ matrix.os }}, ${{ matrix.python-version || '.python-version' }}{% endraw %})
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    timeout-minutes: 20
    # CI runners have no GPU. Force the CPU PyTorch build for every `uv`
    # command (sync + run) regardless of the project's compute_backend:
    # CPU wheels are far smaller than CUDA wheels and — unlike CUDA wheels —
    # are published for macOS too, so the cross-OS matrix resolves cleanly.
    # `uv` re-resolves against this index and ignores the committed
    # CUDA `uv.lock` for the CI run only.
    env:
      UV_INDEX: pytorch=https://download.pytorch.org/whl/cpu

    strategy:
      fail-fast: false
      matrix:
        # Every supported Python on Linux; Windows and macOS run
        # `.python-version` only, since platform differences rarely
        # depend on the Python version.
        os: [ubuntu-latest]
        python-version: {{ python_versions | tojson }}
        include:
          - os: windows-latest
          - os: macos-latest

    steps:
      - uses: actions/checkout@v7

      - name: Set up uv
        uses: astral-sh/setup-uv@v10.3.0
        with:
          enable-cache: true
          python-version: {% raw %}${{ matrix.python-version }}{% endraw %}

      - name: Sync dependencies (CPU PyTorch)
        run: uv sync --group dev

      - name: Ruff format check
        run: uv run ruff format --check .

      - name: Ruff lint
        run: uv run ruff check .

      - name: Type check
        run: uv run ty check
{%- if use_pytest %}

      - name: Tests
        run: uv run pytest
{%- else %}

      - name: Import check
        run: uv run python -c "import {{ package_name }}"
{%- endif %}
{%- if is_library %}

  build:
    name: Build and check distributions
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - uses: actions/checkout@v7

      - name: Set up uv
        uses: astral-sh/setup-uv@v10.3.0
        with:
          enable-cache: true

      - name: Build sdist and wheel
        run: uv build

      - name: Verify metadata
        run: uvx twine check dist/*

      # A fresh environment holding only the wheel catches modules or the
      # `py.typed` marker left out of the distribution.
      - name: Install the wheel and import the package
        run: >-
          uv run --isolated --no-project --python {{ python_version }}
          --with dist/*.whl
          python -c "from importlib.resources import files;
          assert files('{{ package_name }}').joinpath('py.typed').is_file()"
{%- endif %}

  lock:
    # Validate the committed (real-backend) `uv.lock`. The `check` job's
    # CPU override re-resolves, so it never catches a stale CUDA lock;
    # this job resolves metadata against the project's own index (no GPU,
    # no wheel download) and fails if `uv.lock` is out of date.
    name: Verify lockfile
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v6

      - name: Set up uv
        uses: astral-sh/setup-uv@v8.1.0
        with:
          enable-cache: true

      - name: Check the committed lockfile is up to date
        run: uv lock --check
