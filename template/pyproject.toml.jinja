{% if is_library -%}
# ========================== #
#        Build System        #
# ========================== #

[build-system]
requires = ["uv_build>=0.11.15,<0.12"]
build-backend = "uv_build"

{% endif -%}
# ========================== #
#      Project Metadata      #
# ========================== #

[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ project_description }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
license = "MIT"
authors = [
    { name = "{{ author_name }}", email = "{{ author_email }}" },
]
classifiers = [
    "Development Status :: 4 - Beta",
    "Intended Audience :: Developers",
    "License :: OSI Approved :: MIT License",
    "Operating System :: OS Independent",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: {{ python_version }}",
    "Programming Language :: Python :: Implementation :: CPython",
    "Topic :: Scientific/Engineering :: Artificial Intelligence",
{%- if is_library %}
    "Typing :: Typed",
{%- endif %}
    # See https://pypi.org/classifiers/ for more classifiers
]
keywords = []
dependencies = [
    # uv pulls the platform-appropriate wheel from PyPI automatically:
    # a CUDA build on Linux, a CPU/MPS build on macOS. To pin a specific
    # backend, add a [[tool.uv.index]] for https://download.pytorch.org/whl/<backend>.
    "torch>=2.12",
    "torchvision",
]

[project.urls]
GitHub = "https://www.github.com/{{ github_username }}/{{ repo_name }}"

# ========================== #
#      [tool.*] Sections     #
# ========================== #

[dependency-groups]
dev = [
{%- if use_pytest %}
    "pytest>=9.0.3",
{%- endif %}
    "ruff>=0.15.13",
    "ty>=0.0.37",
]

{% if is_library -%}
[tool.uv.build-backend]
module-name = "{{ package_name }}"
module-root = ""
# See the following documentation for more information
# https://docs.astral.sh/uv/concepts/build-backend/

{% endif -%}
[tool.ty.environment]
python-version = "{{ python_version }}"

[tool.ty.src]
exclude = [{% if use_pytest %}"tests/"{% endif %}]

[tool.ty.terminal]
error-on-warning = true
# See the following documentation for more information
# https://docs.astral.sh/ty/reference/configuration/
# https://docs.astral.sh/ty/reference/rules/

{% if use_pytest -%}
[tool.pytest.ini_options]
minversion = "9.0"
cache_dir = "./.cache/pytest"
testpaths = ["tests"]
addopts = ["-ra", "--strict-markers", "--strict-config", "--import-mode=importlib"]
# See the following documentation for more information
# https://docs.pytest.org/en/stable/reference/customize.html
# https://docs.pytest.org/en/stable/reference/reference.html#configuration-options

{% endif -%}
[tool.ruff]
required-version = ">=0.15.13"
cache-dir = "./.cache/ruff"
extend-exclude = [
    ".cache",
    "__pycache__",
    "*.pyc",
    ".pytest_cache",
    ".ipynb_checkpoints",
    "*.egg-info",
]
line-length = 88
indent-width = 4
# preview = true  # Uncomment to enable unstable features

[tool.ruff.format]
quote-style = "double"
indent-style = "space"
docstring-code-format = true
line-ending = "auto"
# preview = true  # Uncomment to enable unstable formatter features

[tool.ruff.lint]
select = [
    # Core linting
    "E",     # pycodestyle (errors)
    "F",     # pyflakes
    "W",     # pycodestyle (warnings)
    # Code quality
    "B",     # flake8-bugbear
    "SIM",   # flake8-simplify
    "PERF",  # Perflint
    "FURB",  # refurb
    "RUF",   # Ruff-specific rules
    # Security
    "S",     # flake8-bandit (security)
    # Type checking
    "ANN",   # flake8-annotations
    "TC",    # flake8-type-checking
    # Import and organization
    "I",     # isort
    "TID",   # flake8-tidy-imports
    "INP",   # flake8-no-pep420 (implicit namespace packages)
{%- if use_pytest %}
    # Testing
    "PT",    # flake8-pytest-style
{%- endif %}
    # Debugging
    "T10",   # flake8-debugger
    # Error handling
    "BLE",   # flake8-blind-except
    "TRY",   # tryceratops
    "EM",    # flake8-errmsg
    # Async
    "ASYNC", # flake8-async
    # Logging
    "G",     # flake8-logging-format
    "LOG",   # flake8-logging
    # Best practices
    "A",     # flake8-builtins
    "ARG",   # flake8-unused-arguments
    "PTH",   # flake8-use-pathlib
    "SLF",   # flake8-self
    "RET",   # flake8-return
    "RSE",   # flake8-raise
    "SLOT",  # flake8-slots
    "EXE",   # flake8-executable
    # String handling
    "Q",     # flake8-quotes
    "ISC",   # flake8-implicit-str-concat
    "FLY",   # flynt
    # Modern Python
    "UP",    # pyupgrade
    "FA",    # flake8-future-annotations
    # Date and time
    "DTZ",   # flake8-datetimez
    # Other quality checks
    "FBT",   # flake8-boolean-trap
    "COM",   # flake8-comma
    "C4",    # flake8-comprehensions
    "PIE",   # flake8-pie
    "PGH",   # pygrep-hooks
    "N",     # pep8-naming
    "YTT",   # flake8-2020
    "ERA",   # eradicate
    "NPY",   # NumPy-specific rules
]
ignore = [
    # Complexity rules (often too strict for practical code)
    "PLR0904",  # too-many-public-methods
    "PLR0911",  # too-many-return-statements
    "PLR0912",  # too-many-branches
    "PLR0913",  # too-many-arguments
    "PLR0915",  # too-many-statements
    "PLR0916",  # too-many-boolean-expressions
    "PLR2004",  # magic-value-comparison
    # Exception handling
    "TRY003",   # raise-vanilla-args
    # Formatter conflicts (handled by ruff format)
    "E501",     # line-too-long
    "W191",     # tab-indentation
    "E111",     # indentation-not-multiple-of-four
    "E114",     # indentation-not-multiple-of-four-comment
    "E117",     # over-indented
    "COM812",   # missing-trailing-comma
]

[tool.ruff.lint.per-file-ignores]
# Package markers may stay empty — exempt them from the required import.
"__init__.py" = ["I002"]
{% if use_pytest -%}
"tests/**" = [
    "S101",   # `assert` is the primary verb in pytest
    "ANN",    # test functions don't need full annotations
    "FBT",    # `@pytest.mark.parametrize` uses bool positional args
    "ARG",    # pytest fixtures look like unused arguments
]
{% endif %}
[tool.ruff.lint.flake8-annotations]
allow-star-arg-any = true
ignore-fully-untyped = true
mypy-init-return = true
suppress-dummy-args = true
suppress-none-returning = true

[tool.ruff.lint.flake8-bandit]
# check-typed-exception = true

{% if use_pytest -%}
[tool.ruff.lint.flake8-pytest-style]
fixture-parentheses = true
mark-parentheses = true
parametrize-names-type = "tuple"
parametrize-values-type = "tuple"
parametrize-values-row-type = "tuple"

{% endif -%}
[tool.ruff.lint.flake8-quotes]
inline-quotes = "double"
multiline-quotes = "double"
docstring-quotes = "double"
avoid-escape = true

[tool.ruff.lint.flake8-type-checking]
exempt-modules = ["typing", "typing_extensions"]

[tool.ruff.lint.flake8-unused-arguments]
ignore-variadic-names = true

[tool.ruff.lint.isort]
known-first-party = ["{{ package_name }}"]
required-imports = ["from __future__ import annotations"]

[tool.ruff.lint.pycodestyle]
ignore-overlong-task-comments = true

[tool.ruff.lint.pydoclint]
ignore-one-line-docstrings = true

